# Connexion SQL Server (instance SQLEXPRESS2022, port TCP 1433)
DATABASE_URL="sqlserver://localhost:1433;database=bd_clinique;user=sa;password=P@ssw0rd;trustServerCertificate=true"

# Secret JWT (à changer en production)
JWT_SECRET="clinique-dev-secret-2026-change-me"

# Port du backend
PORT=3000

# ============================================================
#  Configuration de l'imprimante de tickets (reçus thermiques)
# ============================================================
# Type: WINDOWS (USB partagée) | NETWORK (Ethernet/WiFi) | NONE (pas d'imprimante)
PRINTER_TYPE=WINDOWS
# Adresse IP de l'imprimante réseau (si PRINTER_TYPE=NETWORK)
PRINTER_IP=192.168.1.100
# Port de l'imprimante réseau (si PRINTER_TYPE=NETWORK)
PRINTER_PORT=9100
# Nom EXACT de l'imprimante dans Windows (Panneau de config > Périphériques et imprimantes)
PRINTER_NAME=POS-80C (copy 2)
# Nom du PARTAGE de l'imprimante (à créer dans Propriétés > Partage > Nom du partage)
PRINTER_SHARE=RECU
# Largeur du papier en caractères (42 ou 48 pour 80mm, 32 pour 58mm)
PRINTER_CHAR_WIDTH=42
# Imprimer automatiquement après chaque paiement (true/false)
PRINTER_AUTO_PRINT=true
PRINTER_BLUETOOTH_DEVICE=YHD-8390_BLE
