// ============================================================
//  Schéma Prisma — Gestion Clinique
//  Base : bd_clinique (SQL Server 2022 Express)
//  Périmètre actuel : module Paramétrage (cf. cahier des charges §16)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ---------- Établissement (multi-clinique, §16.2) ----------
model Clinique {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  nom       String
  adresse   String?
  telephone String?
  statut    String   @default("ACTIF") // ACTIF / INACTIF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services         Service[]
  personnel        Personnel[]
  prestations      Prestation[]
  parametre        Parametre?
  impressionFiles  ImpressionFile[]
  nationalites     Nationalite[]
  residences       Residence[]
  diagnostics      Diagnostic[]
  pathologies      Pathologie[]
  fournisseurs     Fournisseur[]
  fonctions        Fonction[]
  posologies       Posologie[]
  patients         Patient[]
  passages         Passage[]
  paiements        Paiement[]
  medicaments      Medicament[]
  consommables     Consommable[]
  examensLabo      ExamenLabo[]
  examensImagerie  ExamenImagerie[]
  chambres         Chambre[]
  hospitalisations Hospitalisation[]
  typesChambres    TypeChambre[]
  imprimantes      Imprimante[]
  affectations     Affectation[]
  assurances       Assurance[]
  grossesses       Grossesse[]
  soins            Soin[]

  @@map("cliniques")
}

// ---------- Patients ----------
model Patient {
  id                  Int      @id @default(autoincrement())
  cliniqueId          Int
  numeroDossier       String // unique par clinique
  code                String   @unique // code unique PERMANENT du patient (ex. P-9N7Z5A) : clé de recherche à vie
  nom                 String
  prenom              String
  age                 String?
  sexe                String? // M / F
  ville               String?
  quartier            String?
  profession          String?
  telephone           String?
  // Données administratives de la fiche de consultation curative
  nationalite         String?
  scolarisation       String? // OUI / NON / NA
  statutConjugal      String?
  typePopulation      String? // POPULATION_GENERALE / TS / OEV / HSH / PC
  populationsRisque   String?
  protectionSociale   String? // NON_ASSURE / CMU / ASSURANCE_PRIVEE / CMU_AP / INDIGENT
  residenceHabituelle String?
  residenceActuelle   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinique Clinique  @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  passages Passage[]

  consultations    Consultation[]
  examensLabo      ExamenLabo[]
  examensImagerie  ExamenImagerie[]
  hospitalisations Hospitalisation[]
  assurances       PatientAssurance[]
  grossesses       Grossesse[]
  soins            Soin[]

  @@unique([cliniqueId, numeroDossier])
  @@map("patients")
}

// ---------- Passages (le N° d'ordre expire après 10 jours ; le code du patient est permanent) ----------
model Passage {
  id                 Int      @id @default(autoincrement())
  cliniqueId         Int
  patientId          Int
  numeroOrdre        String // ex. MED-001092026 (code service + ordre/mois/année)
  serviceId          Int
  typePatient        String   @default("INTERNE") // INTERNE / EXTERNE
  motif              String?
  referent           String? // patient externe : structure/professionnel référent
  prestationDemandee String? // patient externe : prestation demandée
  statut             String   @default("EN_ATTENTE_PAIEMENT") // CREE, EN_ATTENTE_PAIEMENT, ACTIF, UTILISE, CLOTURE, EXPIRE
  // Constantes saisies à l'accueil (§5.1)
  taille             String?
  temperature        Decimal? @db.Decimal(4, 1)
  pouls              Int?
  tensionGauche      String? // ex. 12/8
  tensionDroite      String?
  poids              Decimal? @db.Decimal(5, 1)
  perimetreBrachial  String? // cm — constante saisie à l'accueil
  perimetreCranien   String? // cm — constante saisie à l'accueil
  expireLe           DateTime // validité : 10 jours (§4.3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinique Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  prestations     PassagePrestation[]
  paiements       Paiement[]
  consultations   Consultation[]
  examensLabo     ExamenLabo[]
  examensImagerie ExamenImagerie[]
  hospitalisation Hospitalisation?
  affectation     Affectation?
  soins           Soin[]

  @@unique([cliniqueId, numeroOrdre])
  @@map("passages")
}

// ---------- Prestations rattachées à un passage (caisse, §6) ----------
model PassagePrestation {
  id           Int      @id @default(autoincrement())
  passageId    Int
  prestationId Int? // référence (gardée nullable pour l'historique)
  libelle      String // copie du libellé au moment de l'ajout
  montant      Decimal  @db.Decimal(18, 2)
  serviceId    Int?
  source       String   @default("ACCUEIL") // ACCUEIL / MANUEL / PRESCRIPTION
  statut       String   @default("EN_ATTENTE") // EN_ATTENTE / PAYEE / ANNULEE
  paiementId   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passage         Passage          @relation(fields: [passageId], references: [id], onDelete: Cascade)
  // NoAction : évite les chemins de cascade multiples (l'annulation d'un paiement est douce)
  paiement        Paiement?        @relation(fields: [paiementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prestation      Prestation?      @relation(fields: [prestationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  examenLabo      ExamenLabo?
  examenImagerie  ExamenImagerie?
  hospitalisation Hospitalisation? @relation("LignesHospitalisation")
  soin            Soin?

  @@map("passages_prestations")
}

// ---------- Médicaments (catalogue, prescrits en consultation §7) ----------
model Medicament {
  id          Int      @id @default(autoincrement())
  cliniqueId  Int
  nom         String
  forme       String? // comprimé, sirop, injectable, pommade...
  dosage      String? // 500 mg, 125 mg/5 ml...
  stock       Int      @default(0) // quantité disponible (compteur tenu par la pharmacie)
  seuilAlerte Int      @default(0) // alerte de stock minimum (§9.2)
  prixVente   Decimal? @db.Decimal(18, 2) // prix de vente à l'unité de vente
  uniteVente  String   @default("BOITE") // BOITE / PLAQUE
  consommable Boolean  @default(false) // consommable = non facturé en caisse pharmacie (montant 0)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinique      Clinique            @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prescriptions Prescription[]
  lots          Lot[]
  mouvements    MouvementStock[]
  lignes        LigneDispensation[]

  @@unique([cliniqueId, nom])
  @@map("medicaments")
}

// ---------- Lots de médicaments (§9.2) ----------
model Lot {
  id               Int      @id @default(autoincrement())
  medicamentId     Int
  numeroLot        String
  quantiteInitiale Int
  quantiteRestante Int
  datePeremption   DateTime @db.Date
  prixAchat        Decimal? @db.Decimal(18, 2)
  fournisseur      String? // fournisseur du lot (saisi à l'entrée de stock)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  medicament Medicament       @relation(fields: [medicamentId], references: [id], onDelete: Cascade)
  mouvements MouvementStock[]

  @@map("lots")
}

// ---------- Mouvements de stock (médicaments, §9.2) ----------
model MouvementStock {
  id            Int      @id @default(autoincrement())
  medicamentId  Int
  type          String // ENTREE / SORTIE / INVENTAIRE
  quantite      Int // signée : + entrée, - sortie, ± ajustement d'inventaire
  lotId         Int?
  reference     String? // n° de lot, ordonnance, fournisseur...
  utilisateurId Int?
  commentaire   String?
  createdAt     DateTime @default(now())

  medicament  Medicament   @relation(fields: [medicamentId], references: [id], onDelete: Cascade)
  lot         Lot?         @relation(fields: [lotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("mouvements_stock")
}

// ---------- Dispensations (ordonnances servies, §9.1) ----------
model Dispensation {
  id             Int       @id @default(autoincrement())
  consultationId Int
  pharmacienId   Int // utilisateur qui dispense
  statut         String    @default("EN_COURS") // EN_COURS / CLOTUREE
  montantTotal   Decimal   @default(0) @db.Decimal(18, 2)
  clotureeLe     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  consultation Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  pharmacien   Utilisateur         @relation(fields: [pharmacienId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignes       LigneDispensation[]
  paiement     PharmaciePaiement?

  @@map("dispensations")
}

// ---------- Lignes de dispensation ----------
model LigneDispensation {
  id                Int     @id @default(autoincrement())
  dispensationId    Int
  prescriptionId    Int?
  medicamentId      Int?
  medicamentNom     String // copie du nom
  quantitePrescrite String? // texte de la prescription d'origine
  quantiteDelivree  Int
  uniteVente        String? // BOITE / PLAQUE (copie au moment de la dispensation)
  prixUnitaire      Decimal @db.Decimal(18, 2)
  montant           Decimal @db.Decimal(18, 2)

  dispensation Dispensation  @relation(fields: [dispensationId], references: [id], onDelete: Cascade)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medicament   Medicament?   @relation(fields: [medicamentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("dispensations_lignes")
}

// ---------- Paiements de la caisse pharmacie (§9.1) ----------
model PharmaciePaiement {
  id              Int       @id @default(autoincrement())
  dispensationId  Int       @unique
  caissierId      Int // utilisateur qui encaisse (pharmacien)
  numeroRecu      String
  montantTotal    Decimal   @db.Decimal(18, 2)
  modePaiement    String    @default("ESPECES") // ESPECES / MOBILE_MONEY / CARTE
  statut          String    @default("VALIDE") // VALIDE / ANNULE
  motifAnnulation String?
  dateAnnulation  DateTime?
  createdAt       DateTime  @default(now())

  dispensation Dispensation @relation(fields: [dispensationId], references: [id], onDelete: Cascade)
  caissier     Utilisateur  @relation(fields: [caissierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("pharmacie_paiements")
}

// ---------- Consommables (§9.3) ----------
model Consommable {
  id          Int      @id @default(autoincrement())
  cliniqueId  Int
  nom         String
  unite       String? // flacon, paquet, rouleau...
  quantite    Int      @default(0)
  seuilAlerte Int      @default(0)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinique   Clinique               @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mouvements MouvementConsommable[]

  @@unique([cliniqueId, nom])
  @@map("consommables")
}

// ---------- Mouvements de consommables ----------
model MouvementConsommable {
  id            Int      @id @default(autoincrement())
  consommableId Int
  type          String // ENTREE / SORTIE / INVENTAIRE
  quantite      Int // signée
  reference     String?
  utilisateurId Int?
  commentaire   String?
  createdAt     DateTime @default(now())

  consommable Consommable  @relation(fields: [consommableId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("mouvements_consommables")
}

// ---------- Consultations (§7) ----------
model Consultation {
  id                        Int       @id @default(autoincrement())
  passageId                 Int       @unique
  patientId                 Int
  medecinId                 Int // utilisateur médecin
  motif                     String?
  observation               String? // examen physique
  diagnostic                String?
  hospitalisation           Boolean   @default(false)
  hospitalisationDuree      String?
  // Hospitalisation (§13) : type + durée en jours + chambre choisie par le médecin
  typeHospitalisation       String? // MISE_EN_OBSERVATION (0-3 j) / MOYENNE (3-10 j) / LONGUE (> 10 j)
  hospitalisationDureeJours Int?
  litId                     Int?
  statut                    String    @default("EN_COURS") // EN_COURS / VALIDEE
  valideeLe                 DateTime?
  ordonnanceSauveeLe        DateTime? // date de sauvegarde explicite de l'ordonnance
  numeroOrdonnance          String? // ORD-00045 (généré à la première prescription)
  ordonnanceStatut          String    @default("EN_ATTENTE") // EN_ATTENTE / TRAITEE (pharmacie)
  // ── Fiche de consultation curative ──
  modeEntree                String? // VENUE_DIRECTE / REFERE_CENTRE / REFERE_MEDECIN / AUTRE
  modeEntreeAutre           String?
  traitementAnterieur       String?
  hta                       Boolean?
  diabete                   Boolean?
  antecedentsMedicaux       String?
  antecedentsChirurgicaux   String?
  ddr                       String? // date des dernières règles
  grossesseEnCours          Boolean?
  tabac                     Boolean?
  alcool                    Boolean?
  typeSuivi                 String?
  consultantType            String? // CONTROLE / SOINS
  imc                       String?
  zscore                    String?
  frequenceRespiratoire     String?
  perimetreBrachial         String?
  perimetreCranien          String?
  rechercheTB               String? // OUI / NON / NA
  pathologiesAssociees      String?
  tdrPaludisme              String? // POSITIF / NEGATIF / NON_REALISE / NA
  goutteEpaisse             String? // POSITIVE / NEGATIVE / NON_REALISEE / NA
  mildaEligible             String? // OUI / NON / NA
  mildaRemise               String? // OUI / NON / NA
  cdipPropose               Boolean?
  cdipRealise               Boolean?
  codeDepistage             String?
  glycemieAjeun             String?
  glycemieNonAjeun          String?
  autresExamens             String?
  conduiteTenir             String? // traitement : médicaments, posologie, voie, durée, conseils
  issueSortie               String? // HOSPITALISE / MO / REFERE_INTERNE / REFERE_EXTERNE
  casPresumeTB              String? // A_REVOIR / DECEDE
  moDureeHeures             Int?
  moDureeMinutes            Int?
  moDebut                   DateTime?
  moFin                     DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  passage       Passage        @relation(fields: [passageId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medecin       Utilisateur    @relation(fields: [medecinId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lit           Lit?           @relation(fields: [litId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  medicaments   Prescription[]
  dispensations Dispensation[]

  @@map("consultations")
}

// ---------- Prescriptions de médicaments ----------
model Prescription {
  id             Int      @id @default(autoincrement())
  consultationId Int
  medicamentId   Int?
  medicamentNom  String // copie du nom au moment de la prescription
  forme          String?
  posologie      String?
  quantite       String?
  duree          String?
  createdAt      DateTime @default(now())

  consultation Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  medicament   Medicament?         @relation(fields: [medicamentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignes       LigneDispensation[]

  @@map("prescriptions")
}

// ---------- Laboratoire (§11) ----------
model ExamenLabo {
  id                  Int       @id @default(autoincrement())
  passageId           Int
  passagePrestationId Int       @unique // ligne de prestation LAB payée qui déclenche l'examen
  cliniqueId          Int
  patientId           Int
  libelle             String // copie du libellé de la prestation (l'historique reste lisible)
  statut              String    @default("PRELEVE") // PRELEVE / RESULTATS / VALIDE
  preleveParId        Int? // utilisateur ayant fait le prélèvement
  preleveLe           DateTime?
  conclusion          String? // texte libre du compte rendu
  valideParId         Int? // utilisateur ayant validé
  valideLe            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  passage           Passage           @relation(fields: [passageId], references: [id], onDelete: Cascade)
  // NoAction : évite un chemin de cascade multiple Passage → PassagePrestation → ExamenLabo
  passagePrestation PassagePrestation @relation(fields: [passagePrestationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinique          Clinique          @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prelevePar        Utilisateur?      @relation("Prelevements", fields: [preleveParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validePar         Utilisateur?      @relation("Validations", fields: [valideParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignes            ResultatLigne[]

  @@map("examens_labo")
}

// ---------- Lignes de résultats d'examen (paramètre / valeur / unité / normes) ----------
model ResultatLigne {
  id           Int     @id @default(autoincrement())
  examenLaboId Int
  parametre    String // ex. Hémoglobine
  valeur       String? // ex. 12.5
  unite        String? // ex. g/dL
  normes       String? // ex. 11.5 - 16.0

  examenLabo ExamenLabo @relation(fields: [examenLaboId], references: [id], onDelete: Cascade)

  @@map("examens_labo_lignes")
}

// ---------- Imagerie médicale (§12) ----------
model ExamenImagerie {
  id                  Int       @id @default(autoincrement())
  passageId           Int
  passagePrestationId Int       @unique // ligne de prestation IMA payée
  cliniqueId          Int
  patientId           Int
  libelle             String // copie du libellé (l'historique reste lisible)
  statut              String    @default("RESULTATS") // RESULTATS / VALIDE (créé à la saisie du compte rendu)
  indication          String? // section 1 du compte rendu
  technique           String? // section 2
  resultat            String? // section 3
  conclusion          String? // section 4
  valideParId         Int? // utilisateur ayant validé
  valideLe            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  passage           Passage           @relation(fields: [passageId], references: [id], onDelete: Cascade)
  // NoAction : évite un chemin de cascade multiple Passage → PassagePrestation → ExamenImagerie
  passagePrestation PassagePrestation @relation(fields: [passagePrestationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinique          Clinique          @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validePar         Utilisateur?      @relation("ValidationsImagerie", fields: [valideParId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("examens_imagerie")
}

// ---------- Imprimantes par poste (§14) ----------
model Imprimante {
  id         Int      @id @default(autoincrement())
  cliniqueId Int
  poste      String // TICKET / RECU / PHARMACIE / ORDONNANCE / IMAGERIE
  libelle    String // ex. « Imprimante de tickets »
  type       String   @default("WINDOWS") // WINDOWS / NETWORK / BLUETOOTH / NONE
  nom        String? // nom Windows
  partage    String? // nom du partage Windows (impression brute fidèle)
  ip         String?
  port       Int      @default(9100)
  largeur    Int      @default(42)
  autoPrint  Boolean  @default(true)
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clinique Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliniqueId, poste])
  @@map("imprimantes")
}

// File d'attente d'impression : quand le backend tourne sur le VPS,
// il ne peut pas atteindre les imprimantes de la clinique. Les tickets
// sont donc déposés ici et un « agent » installé à la clinique les
// récupère et les imprime (type AGENT dans la config des imprimantes).
model ImpressionFile {
  id         Int       @id @default(autoincrement())
  cliniqueId Int
  poste      String // TICKET / RECU / PHARMACIE / ORDONNANCE / IMAGERIE
  libelle    String? // description (ex. « Reçu de paiement REC-0001 »)
  contenu    String    @db.NVarChar(Max) // texte ESC/POS à imprimer (encodage latin1) — peut dépasser 1000 caractères
  partage    String? // nom du partage Windows cible (snapshot au moment de l'ajout)
  nom        String? // nom Windows de l'imprimante cible (snapshot)
  statut     String    @default("EN_ATTENTE") // EN_ATTENTE / EN_COURS (pris par l'agent) / IMPRIMEE / ECHEC
  erreur     String?
  createdAt  DateTime  @default(now())
  printedAt  DateTime?

  clinique Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cliniqueId, poste, statut])
  @@map("impression_file")
}

// ─── Paramétrage : une table dédiée par type de liste ─────────
// (même structure pour chacune ; utilisées en listes déroulantes
// avec saisie libre auto-alimentée dans les formulaires)

model Nationalite {
  id         Int      @id @default(autoincrement())
  cliniqueId Int
  libelle    String
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinique   Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliniqueId, libelle])
  @@map("nationalites")
}

model Residence {
  id         Int      @id @default(autoincrement())
  cliniqueId Int
  libelle    String
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinique   Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliniqueId, libelle])
  @@map("residences")
}

model Diagnostic {
  id         Int      @id @default(autoincrement())
  cliniqueId Int
  libelle    String
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinique   Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliniqueId, libelle])
  @@map("diagnostics")
}

model Pathologie {
  id         Int      @id @default(autoincrement())
  cliniqueId Int
  libelle    String
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinique   Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliniqueId, libelle])
  @@map("pathologies")
}

model Fournisseur {
  id         Int      @id @default(autoincrement())
  cliniqueId Int
  libelle    String
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinique   Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliniqueId, libelle])
  @@map("fournisseurs")
}

model Fonction {
  id         Int      @id @default(autoincrement())
  cliniqueId Int
  libelle    String
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinique   Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliniqueId, libelle])
  @@map("fonctions")
}

model Posologie {
  id         Int      @id @default(autoincrement())
  cliniqueId Int
  libelle    String
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinique   Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliniqueId, libelle])
  @@map("posologies")
}

// ---------- Types de chambres (référentiel, §13) ----------
model TypeChambre {
  id         Int      @id @default(autoincrement())
  cliniqueId Int
  libelle    String // Simple, Double, Suite, VIP…
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clinique Clinique  @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chambres Chambre[]

  @@unique([cliniqueId, libelle])
  @@map("types_chambres")
}

// ---------- Hospitalisation (§13) ----------
model Chambre {
  id              Int      @id @default(autoincrement())
  cliniqueId      Int
  numero          String // 101, 102…
  typeChambreId   Int? // type paramétrable (Simple, Double, Suite…)
  tarifJournalier Decimal? @db.Decimal(18, 2) // tarif par nuit (sinon tarif HOSP-JOUR)
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinique    Clinique     @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  typeChambre TypeChambre? @relation(fields: [typeChambreId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  lits        Lit[]

  @@unique([cliniqueId, numero])
  @@map("chambres")
}

// ---------- Lits (§13) ----------
model Lit {
  id        Int     @id @default(autoincrement())
  chambreId Int
  numero    String // A, B… (affiché "101-A")
  actif     Boolean @default(true)

  chambre          Chambre           @relation(fields: [chambreId], references: [id], onDelete: Cascade)
  hospitalisations Hospitalisation[]
  consultations    Consultation[]

  @@unique([chambreId, numero])
  @@map("lits")
}

// ---------- Séjours d'hospitalisation (§13) ----------
model Hospitalisation {
  id                  Int       @id @default(autoincrement())
  passageId           Int       @unique // un séjour par passage (v1)
  cliniqueId          Int
  patientId           Int
  litId               Int
  dateEntree          DateTime
  dateSortie          DateTime?
  dureePrevue         String? // copie de la durée prévue (fiche médecin)
  motif               String? // motif d'hospitalisation
  observations        String? // suivi du séjour
  statut              String    @default("EN_COURS") // EN_COURS / SORTI
  sortieMotif         String? // EXEAT / TRANSFERT / DECES / AUTRE
  sortieParId         Int?
  nbJoursFactures     Int? // jours calculés à la sortie
  montantJournalier   Decimal?  @db.Decimal(18, 2) // copie du tarif à la sortie
  passagePrestationId Int?      @unique // ligne de prestation créée à la sortie (payable à la caisse)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  passage     Passage            @relation(fields: [passageId], references: [id], onDelete: Cascade)
  clinique    Clinique           @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lit         Lit                @relation(fields: [litId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sortiePar   Utilisateur?       @relation("SortiesHospitalisations", fields: [sortieParId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ligneCaisse PassagePrestation? @relation("LignesHospitalisation", fields: [passagePrestationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("hospitalisations")
}

// ---------- Paiements (caisse, §6) ----------
model Paiement {
  id              Int       @id @default(autoincrement())
  cliniqueId      Int
  passageId       Int
  caissierId      Int // utilisateur ayant encaissé
  numeroRecu      String // unique par clinique
  montantTotal    Decimal   @db.Decimal(18, 2)
  modePaiement    String    @default("ESPECES") // ESPECES / MOBILE_MONEY / CARTE
  statut          String    @default("VALIDE") // VALIDE / ANNULE
  motifAnnulation String?
  dateAnnulation  DateTime?
  // Prise en charge assurance
  assuranceId     Int?
  formuleLibelle  String? // copie du libellé de la formule
  tauxParametre   Int?
  tauxApplique    Int?
  partAssurance   Decimal?  @db.Decimal(18, 2)
  partPatient     Decimal?  @db.Decimal(18, 2)
  motifTaux       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clinique      Clinique            @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  passage       Passage             @relation(fields: [passageId], references: [id], onDelete: Cascade)
  caissier      Utilisateur         @relation(fields: [caissierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lignes        PassagePrestation[]
  priseEnCharge PriseEnCharge[]
  assurance     Assurance?          @relation("PaiementsAssurance", fields: [assuranceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliniqueId, numeroRecu])
  @@map("paiements")
}

// ---------- Paramètres de la clinique (ex. image de la page de connexion) ----------
model Parametre {
  id         Int      @id @default(autoincrement())
  cliniqueId Int      @unique
  loginImage String?  @db.NVarChar(Max) // image au format data URL (base64)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clinique Clinique @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("parametres")
}

// ---------- Services de la clinique ----------
model Service {
  id          Int      @id @default(autoincrement())
  cliniqueId  Int
  code        String // code court (ex. MED, LAB, IMA) — sert aussi au N° d'ordre
  nom         String
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // NoAction : évite les chemins de cascade multiples (SQL Server)
  clinique    Clinique            @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personnel   Personnel[]
  prestations Prestation[]
  passages    Passage[]
  lignes      PassagePrestation[]

  @@unique([cliniqueId, code])
  @@map("services")
}

// ---------- Personnel (fiche RH, §16.3) ----------
model Personnel {
  id           Int       @id @default(autoincrement())
  cliniqueId   Int
  matricule    String // unique par clinique (§16.2)
  nom          String
  prenom       String
  sexe         String? // M / F
  photo        String?   @db.NVarChar(Max) // photo du membre du personnel (data URL base64)
  fonction     String // médecin, agent d'accueil, pharmacien...
  serviceId    Int?
  telephone    String?
  email        String?
  statut       String    @default("ACTIF") // ACTIF / INACTIF
  dateEmbauche DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clinique    Clinique     @relation(fields: [cliniqueId], references: [id], onDelete: Cascade)
  service     Service?     @relation(fields: [serviceId], references: [id])
  utilisateur Utilisateur?

  @@unique([cliniqueId, matricule])
  @@map("personnel")
}

// ---------- Utilisateurs (comptes de connexion, §16.2/16.3) ----------
model Utilisateur {
  id                Int       @id @default(autoincrement())
  personnelId       Int       @unique
  matricule         String    @unique // login
  motDePasse        String // hash bcrypt
  roleId            Int
  statut            String    @default("ACTIF") // ACTIF / SUSPENDU
  derniereConnexion DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  personnel Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id])

  paiements               Paiement[]
  consultations           Consultation[]
  dispensations           Dispensation[]
  paiementsPharma         PharmaciePaiement[]
  mouvementsStock         MouvementStock[]
  visitesCpn              VisiteCpn[]            @relation("VisitesCpn")
  accouchements           Accouchement[]         @relation("Accouchements")
  realisationsSoins       RealisationSoin[]      @relation("RealisationsSoins")
  mouvementsConsommables  MouvementConsommable[]
  prelevements            ExamenLabo[]           @relation("Prelevements")
  validations             ExamenLabo[]           @relation("Validations")
  validationsImagerie     ExamenImagerie[]       @relation("ValidationsImagerie")
  sortiesHospitalisations Hospitalisation[]      @relation("SortiesHospitalisations")
  affectations            Affectation[]          @relation("AffectationsMedecin")
  disponibilite           String                 @default("INDISPONIBLE") // DISPONIBLE / INDISPONIBLE (médecins)
  derniereActivite        DateTime? // signal de vie : le poste du médecin est allumé (heartbeat)

  @@map("utilisateurs")
}

// ---------- Rôles ----------
model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique // ADMINISTRATEUR, ACCUEIL, CAISSE, MEDECIN...
  nom         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  utilisateurs  Utilisateur[]
  habilitations RoleModule[]

  @@map("roles")
}

// ---------- Modules applicatifs ----------
model Module {
  id          Int     @id @default(autoincrement())
  code        String  @unique // ACCUEIL, CAISSE, CONSULTATION...
  nom         String
  description String?

  habilitations RoleModule[]

  @@map("modules")
}

// ---------- Habilitations rôle ↔ module (§16) ----------
model RoleModule {
  roleId     Int
  moduleId   Int
  lecture    Boolean @default(true)
  ecriture   Boolean @default(true)
  validation Boolean @default(false)

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleId])
  @@map("roles_modules")
}

// ---------- Assurances et prises en charge ----------
model Assurance {
  id             Int      @id @default(autoincrement())
  cliniqueId     Int
  code           String // SUNU, NSIA, MUGEF…
  libelle        String
  telephone      String?
  email          String?
  adresse        String?
  numeroAgrement String?
  statut         String   @default("ACTIF") // ACTIF / INACTIF
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clinique          Clinique           @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formules          FormuleAssurance[]
  patientAssurances PatientAssurance[]
  priseEnCharges    PriseEnCharge[]
  paiements         Paiement[]         @relation("PaiementsAssurance")

  @@unique([cliniqueId, code])
  @@map("assurances")
}

model FormuleAssurance {
  id          Int       @id @default(autoincrement())
  assuranceId Int
  code        String // STANDARD, PREMIUM…
  libelle     String
  description String?
  dateDebut   DateTime? @db.Date
  dateFin     DateTime? @db.Date
  statut      String    @default("ACTIF") // ACTIF / INACTIF
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assurance         Assurance              @relation(fields: [assuranceId], references: [id], onDelete: Cascade)
  couvertures       CouverturePrestation[]
  patientAssurances PatientAssurance[]
  priseEnCharges    PriseEnCharge[]

  @@unique([assuranceId, code])
  @@map("assurance_formules")
}

model CouverturePrestation {
  id             Int       @id @default(autoincrement())
  formuleId      Int
  prestationId   Int
  tauxCouverture Int // 0-100 (%)
  plafond        Decimal?  @db.Decimal(18, 2)
  dateDebut      DateTime? @db.Date
  dateFin        DateTime? @db.Date
  statut         String    @default("ACTIF") // ACTIF / INACTIF
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  formule    FormuleAssurance @relation(fields: [formuleId], references: [id], onDelete: Cascade)
  prestation Prestation       @relation(fields: [prestationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([formuleId, prestationId])
  @@map("assurance_formule_prestations")
}

model PatientAssurance {
  id                 Int       @id @default(autoincrement())
  patientId          Int
  assuranceId        Int
  formuleId          Int
  numeroAssure       String?
  numeroCarte        String?
  nomAssurePrincipal String?
  typeBeneficiaire   String? // ASSURE / CONJOINT / ENFANT / AUTRE
  dateDebut          DateTime? @db.Date
  dateFin            DateTime? @db.Date
  statut             String    @default("ACTIF") // ACTIF / INACTIF
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  patient   Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assurance Assurance        @relation(fields: [assuranceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formule   FormuleAssurance @relation(fields: [formuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("patient_assurances")
}

model PriseEnCharge {
  id                Int      @id @default(autoincrement())
  paiementId        Int
  ligneId           Int // passagePrestationId facturée
  assuranceId       Int?
  formuleId         Int?
  tauxParametre     Int // taux paramétré au moment de la facturation
  tauxApplique      Int // taux réellement appliqué (modification exceptionnelle possible)
  montantTotal      Decimal  @db.Decimal(18, 2)
  montantAssurance  Decimal  @db.Decimal(18, 2)
  montantPatient    Decimal  @db.Decimal(18, 2)
  motifModification String?
  utilisateurId     Int? // caissière ayant facturé
  createdAt         DateTime @default(now())

  paiement  Paiement          @relation(fields: [paiementId], references: [id], onDelete: Cascade)
  assurance Assurance?        @relation(fields: [assuranceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formule   FormuleAssurance? @relation(fields: [formuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("prise_en_charges")
}

// ---------- Affectation automatique patient → médecin ----------
model Affectation {
  id              Int      @id @default(autoincrement())
  cliniqueId      Int
  passageId       Int      @unique
  medecinId       Int? // null = file globale non affectée
  dateAffectation DateTime @default(now())
  statut          String   @default("EN_ATTENTE") // EN_ATTENTE / EN_CONSULTATION / TERMINE / ANNULE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  passage  Passage      @relation(fields: [passageId], references: [id], onDelete: Cascade)
  clinique Clinique     @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medecin  Utilisateur? @relation("AffectationsMedecin", fields: [medecinId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("affectations")
}

// ---------- Prestations et tarifs ----------
model Prestation {
  id         Int      @id @default(autoincrement())
  cliniqueId Int
  serviceId  Int
  code       String
  libelle    String
  type       String // CONSULTATION, EXAMEN_LABO, IMAGERIE, SOIN, MATERNITE, HOSPITALISATION, MEDICAMENT, AUTRE
  montant    Decimal  @db.Decimal(18, 2)
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clinique Clinique @relation(fields: [cliniqueId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id])

  lignes      PassagePrestation[]
  couvertures CouverturePrestation[]

  @@unique([cliniqueId, code])
  @@map("prestations")
}

// ─── Maternité (CPN, accouchements et suivi) ───────────────────
// Même logique que les autres modules : une grossesse appartient à une
// clinique et à une patiente ; les visites CPN et l'accouchement y sont
// rattachés, avec traçabilité de l'agent.

model Grossesse {
  id                      Int      @id @default(autoincrement())
  cliniqueId              Int
  patientId               Int
  numero                  String   @unique // GRO-0001… généré automatiquement
  ddr                     DateTime @db.Date // date des dernières règles
  dpa                     DateTime @db.Date // date prévue d'accouchement (DDR + 280 j)
  gravidite               Int? // nombre de grossesses (y compris celle-ci)
  parite                  Int? // nombre d'accouchements antérieurs
  antecedentsObstetricaux String? // césarienne, HTA gravidique, fausses couches…
  facteursRisque          String?
  statut                  String   @default("EN_COURS") // EN_COURS / ACCOUCHEE / TERMINEE
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  clinique     Clinique      @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visites      VisiteCpn[]
  accouchement Accouchement?

  @@map("grossesses")
}

model VisiteCpn {
  id                Int       @id @default(autoincrement())
  grossesseId       Int
  numero            Int // CPN1, CPN2…
  date              DateTime  @db.Date
  ageGestationnelSA String? // ex. « 16 SA + 3 j »
  poids             Decimal?  @db.Decimal(5, 1)
  tensionGauche     String?
  tensionDroite     String?
  hauteurUterine    String?
  bcf               String? // bruits du cœur fœtal
  mouvementsActifs  String? // Oui / Non
  oedemes           String? // Oui / Non
  albumine          String?
  sucre             String?
  presentation      String?
  tv                String? // toucher vaginal
  conseils          String? // fer, acide folique, MILDA, VAT…
  prochaineVisite   DateTime? @db.Date
  agentId           Int? // sage-femme ayant réalisé la visite
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  grossesse Grossesse    @relation(fields: [grossesseId], references: [id], onDelete: Cascade)
  agent     Utilisateur? @relation("VisitesCpn", fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("visites_cpn")
}

model Accouchement {
  id            Int      @id @default(autoincrement())
  grossesseId   Int      @unique
  dateHeure     DateTime
  voie          String   @default("VOIE_BASSE") // VOIE_BASSE / CESARIENNE
  termeSA       String?
  sexeEnfant    String? // M / F
  poidsEnfant   Decimal? @db.Decimal(5, 2) // en kg
  apgar         String? // ex. « 8/10 à 5 min »
  issueMere     String? // Vivante / Décédée / Transférée
  issueEnfant   String? // Né vivant / Mort-né / Transféré
  complications String?
  lieu          String? // salle d'accouchement, bloc opératoire…
  agentId       Int? // sage-femme/médecin ayant accouché
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  grossesse Grossesse    @relation(fields: [grossesseId], references: [id], onDelete: Cascade)
  agent     Utilisateur? @relation("Accouchements", fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("accouchements")
}

// ─── Soins (prescriptions et réalisation, §14) ──────────────────
// Même logique que le laboratoire : le soin est rattaché à la ligne de
// prestation SOIN payée à la caisse ; l'agent enregistre chaque
// réalisation (date, observations, agent tracé).

model Soin {
  id                  Int      @id @default(autoincrement())
  passageId           Int
  passagePrestationId Int      @unique // ligne de prestation SOIN payée
  cliniqueId          Int
  patientId           Int
  libelle             String // copie du libellé de la prestation
  statut              String   @default("EN_ATTENTE") // EN_ATTENTE / REALISE
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  passage           Passage           @relation(fields: [passageId], references: [id], onDelete: Cascade)
  passagePrestation PassagePrestation @relation(fields: [passagePrestationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinique          Clinique          @relation(fields: [cliniqueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  realisations      RealisationSoin[]

  @@map("soins")
}

model RealisationSoin {
  id           Int      @id @default(autoincrement())
  soinId       Int
  date         DateTime
  observations String?
  agentId      Int? // agent ayant réalisé le soin
  createdAt    DateTime @default(now())

  soin  Soin         @relation(fields: [soinId], references: [id], onDelete: Cascade)
  agent Utilisateur? @relation("RealisationsSoins", fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("realisations_soins")
}
